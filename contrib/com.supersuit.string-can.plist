<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.supersuit.string-can</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/string-can</string>
		<string>serve</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>STRING_CAN_HOME</key>
		<string>/usr/local/var/string-can</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>/usr/local/var/log/string-can.log</string>
	<key>StandardErrorPath</key>
	<string>/usr/local/var/log/string-can.err</string>
</dict>
</plist>
